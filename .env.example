# ============================================================
# APP
# ============================================================
COMPOSE_PROFILES=mysql #postgres
APP_NAME=APPNAME
APP_ENV=local
APP_DEBUG=true
APP_DOMAIN=https://yourapp.test
APP_TIMEZONE=Europe/London
APP_LOCALE=es

# ============================================================
# DOCKER
# ============================================================
DOCKER_RESTART_POLICY=unless-stopped
WEBSERVER_CONTAINER_NAME=yourapp_webserver
PHP_CONTAINER_NAME=yourapp_php
MARIADB_CONTAINER_NAME=yourapp_mariadb
PHPMYADMIN_CONTAINER_NAME=yourapp_phpmyadmin
PROXY_CONTAINER_NAME=yourapp_proxy

# ============================================================
# DATABASE
# ============================================================
DB_DRIVER=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=app_db
DB_EMAIL=admin@admin
DB_USER=app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_ALLOW_EMPTY_PASSWORD=no
DB_CONNECT_TIMEOUT=5
# ============================================================
# DEVELOPMENT TOOLS
# ============================================================
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
POSTGRES_PORT=5432
PGADMIN_PORT=8081

HTTP_PORT=80
HTTPS_PORT=443


# ============================================================
# SESSION / SECURITY
# ============================================================
SESSION_NAME=yourapp_SESSID
SESSION_TIMEOUT=1800
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

MFA_PENDING_TIMEOUT=300
AUTHORIZATION_CACHE_TTL=0

LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_SECONDS=300

LOGIN_USER_MAX_ATTEMPTS=5
LOGIN_USER_WINDOW_SECONDS=900

TRUSTED_PROXIES=172.30.0.0/24

ADMIN_GATE_SECRET=
ADMIN_GATE_TIMEOUT=3600
RATE_LIMIT_SECRET=